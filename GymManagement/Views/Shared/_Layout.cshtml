@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Bootstrap 5.3.8 css file -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ^ Our main css file -->
    <link rel="stylesheet" href="~/css/style.css" />
    <!--Icon-->
    <link rel="icon" type="image/png" href="~/favicon.ico"/>
    <title>Power fitness | @ViewData["Title"]</title>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white shadow-sm py-3">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand"
                       asp-controller="Home"
                       asp-action="Index">

                    <img src="~/images/logo.jpg"
                         alt="Logo"
                         width="70" />
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Items -->
                <div class="collapse navbar-collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                        <!-- Home -->
                        <li class="nav-item">
                            <a asp-controller="Home"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Home" ? "active text-primary" : "text-dark")">
                                Home
                            </a>
                        </li>

                        <!-- Members -->
                        <li class="nav-item">
                            <a asp-controller="Members"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Members" ? "active text-primary" : "text-dark")">
                                Members
                            </a>
                        </li>

                        <!-- Trainers -->
                        <li class="nav-item">
                            <a asp-controller="Trainers"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Trainers" ? "active text-primary" : "text-dark")">
                                Trainers
                            </a>
                        </li>

                        <!-- Sessions -->
                        <li class="nav-item">
                            <a asp-controller="Sessions"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Sessions" ? "active text-primary" : "text-dark")">
                                Sessions
                            </a>
                        </li>

                        <!-- Plans -->
                        <li class="nav-item">
                            <a asp-controller="Plans"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Plans" ? "active text-primary" : "text-dark")">
                                Plans
                            </a>
                        </li>

                        <!-- Memberships -->
                        <li class="nav-item">
                            <a asp-controller="Memberships"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Memberships" ? "active text-primary" : "text-dark")">
                                Memberships
                            </a>
                        </li>

                        <!-- Session Schedule -->
                        <li class="nav-item">
                            <a asp-controller="Bookings"
                                   asp-action="Index"
                                   class="nav-link px-3 fw-bold fs-5 @(currentController == "Bookings" ? "active text-primary" : "text-dark")">
                                Schedule
                            </a>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-link nav-link px-3 fw-bold fs-5 text-dark text-decoration-none">
                                    Logout
                                </button>
                            </form>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("ValidationScripts", required: false)
</body>
</html>
